# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
venvs/

# Credentials & local session
# Catches any cookie-jar dump variant: cookies, cookies.weibo, .bak, .bak2 ...
src/cookies*
*.weibo
*.weibo.bak
*.weibo.bak2
*.session
session*.json

# Local config (contains account / proxy settings, do NOT commit).
# Real file lives at project root config/; the .example template is committed.
# Ignore everything under config/ except committed templates (*.example).
config/*
!config/*.example

# Logs
src/log/*.log
src/log/weibo.log.*
src/log/*.jsonl
*.log
run_auth.*

# OS & editor
.DS_Store
Thumbs.db
*.swp

# Temporary analysis files & captured HARs (may contain sensitive cookies)
tmp/

# Automation runtime logs (generated by src/automations/ runner; not source)
src/automations/*.jsonl

# Deep-crawl caches (per-user profile / follow-list JSON dumps)
.cache/

# Analysis artifacts (contain real Weibo UIDs / profile PII; generated locally,
# do NOT commit). Re-run `blacklist-deep` to regenerate.
data/

# Runtime-generated video list (regenerated by get_latest_videos.py; do NOT commit)
src/data/latest_videos.json

# Logs (generated per function; do NOT commit)
logs/

# CodeBuddy working memory (local, per-machine context)
.codebuddy/

# Local scanner config (contains real-UID denylist / project-specific PII terms;
# do NOT commit). Copy scripts/scan_config.example.json -> .scan_config.json locally.
.scan_config.json

# Binary assets mirrored by src/static_fetch.py (emoticons, fonts, icons) are
# NOT committed. They are pure CDN payload with no analytical value in Git and
# can always be re-fetched from the recorded URLs in
# src/static/h5.sinaimg.cn/_urls.txt (see `--from-manifest`).
src/static/**/*.bmp
src/static/**/*.eot
src/static/**/*.gif
src/static/**/*.ico
src/static/**/*.jpeg
src/static/**/*.jpg
src/static/**/*.otf
src/static/**/*.png
src/static/**/*.ttf
src/static/**/*.webp
src/static/**/*.woff
src/static/**/*.woff2
